{
  "name": "tempo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tempo: a fast, modern medication and appointment tracker for young, tech-savvy people. Design concept with demo data.",
  "scripts": {
    "dev": "npm run tokens && vite",
    "tokens": "node scripts/build-tokens.ts",
    "contrast": "node scripts/check-contrast.ts",
    "icons": "node scripts/generate-icons.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run tokens && tsc -b && vite build",
    "preview": "vite preview",
    "check": "npm run tokens && npm run contrast && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
