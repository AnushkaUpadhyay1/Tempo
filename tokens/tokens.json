{
  "$meta": {
    "name": "Tempo UI",
    "version": "1.0.0",
    "description": "Design tokens for Tempo. Run `npm run tokens` after editing to regenerate src/styles/tokens.css."
  },
  "color": {
    "ink": {
      "0": "#FFFFFF",
      "50": "#F5F5F7",
      "100": "#EBEBEF",
      "200": "#D6D7DE",
      "300": "#B4B6C2",
      "400": "#8A8D9C",
      "500": "#6B6E7D",
      "600": "#4A4D5B",
      "700": "#353845",
      "800": "#262833",
      "850": "#1C1E27",
      "900": "#15161D",
      "950": "#0C0D12"
    },
    "tangerine": {
      "soft-light": "#FFEDD9",
      "soft-dark": "#3A2416",
      "300": "#FFB27A",
      "400": "#FF8A3D",
      "600": "#C2410C",
      "700": "#9A3412"
    },
    "violet": {
      "soft-light": "#ECEBFF",
      "soft-dark": "#26244D",
      "300": "#C1BEFF",
      "400": "#9894FF",
      "600": "#5145CD",
      "700": "#4031A8"
    },
    "mint": {
      "soft-light": "#DDF7EC",
      "soft-dark": "#0F3027",
      "300": "#7CE8C1",
      "400": "#34D399",
      "600": "#047857",
      "700": "#065F46"
    },
    "sky": {
      "soft-light": "#E0F1FF",
      "soft-dark": "#0F2A40",
      "300": "#8ED3FF",
      "400": "#4FB6FF",
      "600": "#0B6CC2",
      "700": "#0A5598"
    },
    "status": {
      "green-light": "#11703A",
      "green-dark": "#4ADE80",
      "green-soft-light": "#E6F6EC",
      "green-soft-dark": "#10291A",
      "amber-light": "#9A4A00",
      "amber-dark": "#FBBF24",
      "amber-soft-light": "#FFF4DB",
      "amber-soft-dark": "#2E2410",
      "red-light": "#C01F1F",
      "red-dark": "#F87171",
      "red-soft-light": "#FDECEC",
      "red-soft-dark": "#331616",
      "blue-light": "#1D5FC9",
      "blue-dark": "#60A5FA",
      "blue-soft-light": "#E7F0FD",
      "blue-soft-dark": "#13233D"
    }
  },
  "themes": {
    "light": {
      "surface": {
        "page": "{color.ink.50}",
        "card": "{color.ink.0}",
        "muted": "{color.ink.100}",
        "inverse": "{color.ink.950}"
      },
      "text": {
        "primary": "{color.ink.950}",
        "secondary": "{color.ink.600}",
        "tertiary": "{color.ink.500}",
        "inverse": "{color.ink.0}",
        "success": "{color.status.green-light}",
        "warning": "{color.status.amber-light}",
        "danger": "{color.status.red-light}",
        "info": "{color.status.blue-light}"
      },
      "border": {
        "subtle": "{color.ink.200}",
        "strong": "{color.ink.500}"
      },
      "status": {
        "success-bg": "{color.status.green-soft-light}",
        "warning-bg": "{color.status.amber-soft-light}",
        "danger-bg": "{color.status.red-soft-light}",
        "info-bg": "{color.status.blue-soft-light}"
      },
      "focus": {
        "ring": "{color.ink.950}"
      },
      "elevation": {
        "1": "0 1px 2px rgba(12, 13, 18, 0.06), 0 1px 1px rgba(12, 13, 18, 0.04)",
        "2": "0 4px 16px rgba(12, 13, 18, 0.08), 0 1px 3px rgba(12, 13, 18, 0.06)",
        "3": "0 16px 48px rgba(12, 13, 18, 0.18), 0 4px 12px rgba(12, 13, 18, 0.08)"
      },
      "overlay": {
        "scrim": "rgba(12, 13, 18, 0.45)",
        "glass": "rgba(255, 255, 255, 0.78)"
      }
    },
    "dark": {
      "surface": {
        "page": "{color.ink.950}",
        "card": "{color.ink.900}",
        "muted": "{color.ink.850}",
        "inverse": "{color.ink.50}"
      },
      "text": {
        "primary": "{color.ink.50}",
        "secondary": "{color.ink.300}",
        "tertiary": "{color.ink.400}",
        "inverse": "{color.ink.950}",
        "success": "{color.status.green-dark}",
        "warning": "{color.status.amber-dark}",
        "danger": "{color.status.red-dark}",
        "info": "{color.status.blue-dark}"
      },
      "border": {
        "subtle": "{color.ink.800}",
        "strong": "{color.ink.500}"
      },
      "status": {
        "success-bg": "{color.status.green-soft-dark}",
        "warning-bg": "{color.status.amber-soft-dark}",
        "danger-bg": "{color.status.red-soft-dark}",
        "info-bg": "{color.status.blue-soft-dark}"
      },
      "focus": {
        "ring": "{color.ink.0}"
      },
      "elevation": {
        "1": "0 1px 2px rgba(0, 0, 0, 0.4)",
        "2": "0 8px 24px rgba(0, 0, 0, 0.45)",
        "3": "0 24px 64px rgba(0, 0, 0, 0.6)"
      },
      "overlay": {
        "scrim": "rgba(0, 0, 0, 0.6)",
        "glass": "rgba(21, 22, 29, 0.78)"
      }
    }
  },
  "accents": {
    "tangerine": {
      "light": {
        "fill": "{color.tangerine.600}",
        "fill-hover": "{color.tangerine.700}",
        "on-fill": "{color.ink.0}",
        "text": "{color.tangerine.700}",
        "soft": "{color.tangerine.soft-light}"
      },
      "dark": {
        "fill": "{color.tangerine.400}",
        "fill-hover": "{color.tangerine.300}",
        "on-fill": "{color.ink.950}",
        "text": "{color.tangerine.300}",
        "soft": "{color.tangerine.soft-dark}"
      }
    },
    "violet": {
      "light": {
        "fill": "{color.violet.600}",
        "fill-hover": "{color.violet.700}",
        "on-fill": "{color.ink.0}",
        "text": "{color.violet.600}",
        "soft": "{color.violet.soft-light}"
      },
      "dark": {
        "fill": "{color.violet.400}",
        "fill-hover": "{color.violet.300}",
        "on-fill": "{color.ink.950}",
        "text": "{color.violet.300}",
        "soft": "{color.violet.soft-dark}"
      }
    },
    "mint": {
      "light": {
        "fill": "{color.mint.600}",
        "fill-hover": "{color.mint.700}",
        "on-fill": "{color.ink.0}",
        "text": "{color.mint.700}",
        "soft": "{color.mint.soft-light}"
      },
      "dark": {
        "fill": "{color.mint.400}",
        "fill-hover": "{color.mint.300}",
        "on-fill": "{color.ink.950}",
        "text": "{color.mint.300}",
        "soft": "{color.mint.soft-dark}"
      }
    },
    "sky": {
      "light": {
        "fill": "{color.sky.600}",
        "fill-hover": "{color.sky.700}",
        "on-fill": "{color.ink.0}",
        "text": "{color.sky.700}",
        "soft": "{color.sky.soft-light}"
      },
      "dark": {
        "fill": "{color.sky.400}",
        "fill-hover": "{color.sky.300}",
        "on-fill": "{color.ink.950}",
        "text": "{color.sky.300}",
        "soft": "{color.sky.soft-dark}"
      }
    }
  },
  "font": {
    "family": {
      "display": "\"Bricolage Grotesque Variable\", \"Bricolage Grotesque\", system-ui, sans-serif",
      "body": "\"Onest Variable\", Onest, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "mono": "\"Geist Mono Variable\", \"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
    },
    "size": {
      "xs": "0.8125rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.375rem",
      "2xl": "1.75rem",
      "3xl": "2.25rem",
      "4xl": "3rem"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "black": "800"
    },
    "line-height": {
      "body": "1.5",
      "tight": "1.2",
      "display": "1.02"
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "18px",
    "xl": "26px",
    "pill": "999px"
  },
  "motion": {
    "duration": {
      "fast": "140ms",
      "base": "220ms",
      "slow": "380ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "size": {
    "target-min": "44px",
    "target-md": "48px",
    "target-lg": "56px",
    "icon-sm": "16px",
    "icon-md": "20px",
    "icon-lg": "24px",
    "focus-width": "2px",
    "focus-offset": "2px",
    "content-max": "40rem"
  },
  "contrastChecks": [
    { "fg": "text.primary", "bg": "surface.page", "use": "text" },
    { "fg": "text.primary", "bg": "surface.card", "use": "text" },
    { "fg": "text.primary", "bg": "surface.muted", "use": "text" },
    { "fg": "text.secondary", "bg": "surface.page", "use": "text" },
    { "fg": "text.secondary", "bg": "surface.card", "use": "text" },
    { "fg": "text.secondary", "bg": "surface.muted", "use": "text" },
    { "fg": "text.tertiary", "bg": "surface.page", "use": "text" },
    { "fg": "text.tertiary", "bg": "surface.card", "use": "text" },
    { "fg": "text.inverse", "bg": "surface.inverse", "use": "text" },
    { "fg": "text.success", "bg": "surface.card", "use": "text" },
    { "fg": "text.success", "bg": "status.success-bg", "use": "text" },
    { "fg": "text.warning", "bg": "surface.card", "use": "text" },
    { "fg": "text.warning", "bg": "status.warning-bg", "use": "text" },
    { "fg": "text.danger", "bg": "surface.card", "use": "text" },
    { "fg": "text.danger", "bg": "status.danger-bg", "use": "text" },
    { "fg": "text.info", "bg": "surface.card", "use": "text" },
    { "fg": "text.info", "bg": "status.info-bg", "use": "text" },
    { "fg": "border.strong", "bg": "surface.card", "use": "ui" },
    { "fg": "border.strong", "bg": "surface.page", "use": "ui" },
    { "fg": "focus.ring", "bg": "surface.page", "use": "ui" },
    { "fg": "focus.ring", "bg": "surface.card", "use": "ui" },
    { "fg": "text.success", "bg": "surface.muted", "use": "ui" },
    { "fg": "text.warning", "bg": "surface.muted", "use": "ui" }
  ],
  "accentChecks": [
    { "fg": "accent.on-fill", "bg": "accent.fill", "use": "text" },
    { "fg": "accent.on-fill", "bg": "accent.fill-hover", "use": "text" },
    { "fg": "accent.text", "bg": "surface.page", "use": "text" },
    { "fg": "accent.text", "bg": "surface.card", "use": "text" },
    { "fg": "accent.text", "bg": "accent.soft", "use": "text" },
    { "fg": "text.primary", "bg": "accent.soft", "use": "text" },
    { "fg": "accent.fill", "bg": "surface.card", "use": "ui" },
    { "fg": "accent.fill", "bg": "surface.page", "use": "ui" },
    { "fg": "accent.fill", "bg": "surface.muted", "use": "ui" }
  ]
}
